{
  "expo": {
    "name": "BSmak",
    "slug": "bsmak",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "bsmakapp",
    "ios": {
      "bundleIdentifier": "pl.aitt.bsmak"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF1E8"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pl.aitt.bsmak"
    },
    "plugins": [
      ["expo-share-intent", { "androidIntentFilters": ["text/*"] }]
    ]
  }
}
