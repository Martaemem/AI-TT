{
  "expo": {
    "name": "Konkursownik",
    "slug": "konkursownik",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "konkursownik",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "pl.aitt.konkursownik"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pl.aitt.konkursownik",
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#4285F4"
        }
      ]
    ]
  }
}
